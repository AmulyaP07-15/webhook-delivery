# Copy to .env for local runs. docker-compose sets these itself.
DATABASE_URL=postgresql+psycopg2://webhook:webhook@db:5432/webhook
REDIS_URL=redis://redis:6379/0
DEFAULT_MAX_ATTEMPTS=6
HTTP_TIMEOUT_SECONDS=8.0

# Set true ONLY for local testing against localhost receivers. Never in prod.
ALLOW_PRIVATE_URLS=false
